{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "sortPackageJson": false,
  "sortImports": {
    "groups": [["type"], ["external"], ["builtin"], ["parent", "sibling"], "index"],
    "sortSideEffects": true,
    "newlinesBetween": false
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/.release/**",
    "**/.release-stubs/**",
    "**/.tmp-release/**",
    "**/artifacts/**"
  ],
  "semi": true,
  "trailingComma": "es5",
  "singleQuote": true,
  "bracketSpacing": true,
  "tabWidth": 2,
  "printWidth": 100,
  "endOfLine": "lf"
}
